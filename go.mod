module github.com/zeroroot-ai/gibson-executor

go 1.26.8

// v1.0.0 was published in error by an early release-please run (2026-05-10),
// long before the current 0.10x line and with no pre-1.0 sign-off. It hijacks
// `go get ...@latest` (highest semver wins) to a stale commit. The tag is
// deleted from the remote; this retract tells module clients to ignore the
// copy the module proxy has permanently cached (gibson-executor#14).
retract v1.0.0

